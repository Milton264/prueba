# ---------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------
# Panel de Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Clave de servicio. NUNCA exponer al navegador ni subir al repositorio.
# Se usa solo en Server Actions (solicitudes de invitados y acceso por token).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---------------------------------------------------------------
# Sitio
# ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.pes.panamarinesolutions.com

# ---------------------------------------------------------------
# Datos de contacto de PES (tambien editables desde /admin/configuracion)
# ---------------------------------------------------------------
# Formato internacional, solo digitos. Panama = 507
# +507 6679-4702  ->  50766794702
NEXT_PUBLIC_WHATSAPP_NUMBER=50766794702
NEXT_PUBLIC_CONTACT_EMAIL=pes@panamarinesolutions.com
NEXT_PUBLIC_COMPANY_NAME=Panama Energy Solutions

# ---------------------------------------------------------------
# Aviso inmediato de nuevas solicitudes (RFQ)
# ---------------------------------------------------------------
# Crea una API key en Resend y verifica panamarinesolutions.com.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
RFQ_FROM_EMAIL=Panama Energy Solutions <notificaciones@panamarinesolutions.com>
# Uno o varios destinatarios separados por comas.
RFQ_NOTIFICATION_TO=pes@panamarinesolutions.com

# ---------------------------------------------------------------
# Configuración inicial de acceso (/configurar-acceso)
# ---------------------------------------------------------------
# Cerrada por defecto. Para una puesta en marcha puntual, cambia a true,
# define una clave robusta, crea/repara la cuenta y vuelve a false.
ENABLE_SETUP_ROUTE=false
SETUP_SECRET=CAMBIAR_POR_UNA_CLAVE_LARGA_Y_UNICA
